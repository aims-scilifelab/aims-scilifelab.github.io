---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const openings = (await getCollection('openings', (o) => o.data.status === 'open'))
  .sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(openings.map(async (o) => ({ data: o.data, Content: (await o.render()).Content })));
const fmt = (d?: Date) => (d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');

// MSc thesis topics (from the group's stated interests)
const mscTopics = [
  'Analysis of medical imaging data — diagnostic classification, segmentation, and related tasks',
  'Inverse problems such as denoising or super-resolution in microscopy data',
  'Outlier detection in biomedical data',
  'Risk prediction',
];

// ── MSc thesis inquiry form ────────────────────────────────────────────────
// Paste your published Google Form embed URL between the quotes to switch the
// form on. In the Google Form: Send → <> (Embed HTML) → copy the src="…" URL
// (it ends in `?embedded=true`). Suggested questions in the form:
//   • Name   • Email   • Program / year   • Your question or project idea
//   • Upload your CV (a "File upload" question — requires students to sign in
//     with a Google account, which is fine and keeps the files in your Drive).
const MSC_FORM_EMBED = '';   // e.g. 'https://docs.google.com/forms/d/e/1FAIpXXXX/viewform?embedded=true'
---
<Base title="Join" description="Join AIMS — PhD, postdoctoral, engineering and master's thesis opportunities in AI, medicine and the life sciences.">
  <PageHeader eyebrow="Join" title="Join AIMS"
    lede="We work at the intersection of machine learning, medicine and the life sciences, and we're glad when strong, curious people want to work with us." />

  <section class="section-tight">
    <div class="wrap">
      <h2 class="cat">Open positions</h2>
      <p class="muted measure">PhD, postdoctoral, engineering and staff positions are advertised through
      <a class="link" href="https://www.kth.se/en/om/work-at-kth" target="_blank" rel="noopener">KTH</a> and
      <a class="link" href="https://ki.se/en/about/jobs-and-vacancies-at-ki" target="_blank" rel="noopener">Karolinska Institutet&nbsp;(KI)</a>.
      When we have an open call, we link it here — please apply through the official posting.</p>
      {rendered.length > 0 && (
        <ul class="openings">
          {rendered.map(({ data, Content }) => (
            <li class="card opening">
              <h3>{data.title}</h3>
              {data.deadline && <p class="faint dl">Apply by {fmt(data.deadline)}</p>}
              <div class="prose"><Content /></div>
              {data.url && <p><a class="btn btn-ghost" href={data.url} target="_blank" rel="noopener">View the posting</a></p>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <h2 class="cat">Master's thesis projects</h2>
      <p class="muted measure">Master's thesis projects are available for students enrolled at KTH. Areas we're
      currently interested in supervising include:</p>
      <ul class="topics measure muted">
        {mscTopics.map((t) => <li>{t}</li>)}
      </ul>
      <p class="faint measure note">Thesis projects are arranged through KTH's degree-project process.</p>

      <div class="inquiry">
        <h3 class="cat3">Have a project in mind?</h3>
        <p class="muted measure">If you're a student interested in a thesis with us, send a short inquiry — tell us
        your question or idea and attach your CV, and we'll be in touch.</p>
        {MSC_FORM_EMBED ? (
          <div class="formwrap">
            <iframe src={MSC_FORM_EMBED} title="MSc thesis inquiry form" loading="lazy" width="100%" height="920">Loading…</iframe>
          </div>
        ) : (
          <p class="faint measure note">The inquiry form is being set up and will appear here shortly.</p>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .cat { font-size: var(--step-1); }
  .openings { list-style: none; padding: 0; margin-top: 1.2rem; display: grid; gap: 1rem; }
  .opening { padding: clamp(1.1rem, 3vw, 1.6rem); }
  .opening h3 { font-size: var(--step-0); }
  .dl { font-size: var(--step--1); margin-top: .2rem; }
  .opening .prose { margin-top: .6rem; }
  .topics { margin-top: 1rem; padding-left: 1.2rem; display: grid; gap: .5rem; }
  .note { margin-top: 1.2rem; font-size: var(--step--1); }
  .inquiry { margin-top: 2.4rem; padding-top: 1.8rem; border-top: 1px solid var(--border); }
  .cat3 { font-size: var(--step-0); }
  .inquiry p { margin-top: .6rem; }
  .formwrap { margin-top: 1.4rem; max-width: 720px; border: 1px solid var(--border); border-radius: var(--radius);
              overflow: hidden; background: var(--bg-2); }
  .formwrap iframe { display: block; width: 100%; border: 0; }
</style>
