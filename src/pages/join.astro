---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const openings = (await getCollection('openings', (o) => o.data.status === 'open'))
  .sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(openings.map(async (o) => ({ data: o.data, Content: (await o.render()).Content })));
const fmt = (d?: Date) => (d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '');

// MSc thesis topics (from the group's stated interests)
const mscTopics = [
  'Analysis of medical imaging data — diagnostic classification, segmentation, and related tasks',
  'Inverse problems such as denoising or super-resolution in microscopy data',
  'Outlier detection in biomedical data',
  'Risk prediction',
];

// ── Thesis-project application form ─────────────────────────────────────────
// The Google Form (created by automation/join-application-form.gs) used ONLY
// for MSc/BSc student thesis projects. It collects the project idea, CV and
// transcripts; an Apps Script triages each submission and emails the group.
// (PhD / postdoc / staff openings go through the official KTH & KI job boards.)
const APPLY_FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSe__3FbJ880-sdJv_yohkxTjHv1nEODm9MTFtK9sTLDDx5lRg/viewform';
---
<Base title="Join" description="Join AiMS — PhD, postdoctoral, engineering and master's thesis opportunities in AI, medicine and the life sciences.">
  <PageHeader title="Join AiMS"
    lede="We work at the intersection of machine learning, medicine and the life sciences, and we're glad when strong, curious people want to work with us." />

  <section class="section-tight">
    <div class="wrap">
      <h2 class="cat">Open positions</h2>
      <p class="muted measure">PhD, postdoctoral, engineering and staff positions are advertised through the official
      KTH and Karolinska Institutet (KI) job boards. When we have an open call we link it here too — please apply
      through the official posting.</p>
      <p class="job-boards">
        <a class="btn btn-ghost" href="https://www.kth.se/lediga-jobb?l=en" target="_blank" rel="noopener">KTH vacancies</a>
        <a class="btn btn-ghost" href="https://ki.se/en/about-ki/jobs-at-ki/available-positions-at-ki" target="_blank" rel="noopener">KI vacancies</a>
      </p>
      {rendered.length > 0 && (
        <ul class="openings">
          {rendered.map(({ data, Content }) => (
            <li class="card opening">
              <h3>{data.title}</h3>
              {data.deadline && <p class="faint dl">Apply by {fmt(data.deadline)}</p>}
              <div class="prose"><Content /></div>
              {data.url && <p><a class="btn btn-ghost" href={data.url} target="_blank" rel="noopener">View the posting</a></p>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <h2 class="cat">Master's &amp; Bachelor's thesis projects</h2>
      <p class="muted measure">We supervise degree projects (MSc and BSc) for students enrolled at KTH. Areas we're
      currently interested in supervising include:</p>
      <ul class="topics measure muted">
        {mscTopics.map((t) => <li>{t}</li>)}
      </ul>
      <p class="faint measure note">Thesis projects are arranged through KTH's degree-project process.</p>

      <div class="inquiry">
        <h3 class="cat3">Have a project in mind?</h3>
        <p class="muted measure">Tell us about yourself and the project you'd like to do — describe your idea and
        attach your CV and transcripts, and we'll read it and get back to you.</p>
        <p class="cta"><a class="btn btn-primary" href={APPLY_FORM_URL} target="_blank" rel="noopener">Apply for a thesis project</a></p>
        <p class="faint measure note">Uploading files asks you to sign in with a Google account; if that's a problem, the
        form also accepts a shareable link to your CV.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .cat { font-size: var(--step-1); }
  .job-boards { margin-top: 1.3rem; display: flex; flex-wrap: wrap; gap: .7rem; }
  .openings { list-style: none; padding: 0; margin-top: 1.2rem; display: grid; gap: 1rem; }
  .opening { padding: clamp(1.1rem, 3vw, 1.6rem); }
  .opening h3 { font-size: var(--step-0); }
  .dl { font-size: var(--step--1); margin-top: .2rem; }
  .opening .prose { margin-top: .6rem; }
  .topics { margin-top: 1rem; padding-left: 1.2rem; display: grid; gap: .5rem; }
  .note { margin-top: 1.2rem; font-size: var(--step--1); }
  .inquiry { margin-top: 2.4rem; padding-top: 1.8rem; border-top: 1px solid var(--border); }
  .cat3 { font-size: var(--step-0); }
  .inquiry p { margin-top: .6rem; }
  .cta { margin-top: 1.3rem; }
</style>
