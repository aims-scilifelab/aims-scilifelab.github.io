---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry } from 'astro:content';
const pubs = (await getEntry('publications', 'all'))?.data.items ?? [];

// group by year, most recent first
const byYear = new Map<number, typeof pubs>();
for (const p of [...pubs].sort((a, b) => b.year - a.year || a.title.localeCompare(b.title))) {
  if (!byYear.has(p.year)) byYear.set(p.year, []);
  byYear.get(p.year)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<Base title="Publications" description="Publications from the AIMS Laboratory across machine learning, medicine and the life sciences.">
  <PageHeader eyebrow="Publications" title="Publications"
    lede="Our work across foundational machine learning, medicine and the life sciences." />

  <section class="section-tight">
    <div class="wrap">
      <p class="muted measure src-note">Publications from across AIMS — spanning our groups and collaborations. For a
      researcher's full, up-to-date list, see their profile on the <a class="link" href="/people">People</a> page.</p>

      {years.map((y) => (
        <div class="yr">
          <h2 class="year">{y}</h2>
          <ul class="pubs">
            {byYear.get(y)!.map((p) => (
              <li>
                {p.url
                  ? <a class="ptitle" href={p.url} target="_blank" rel="noopener">{p.title}</a>
                  : <span class="ptitle">{p.title}</span>}
                <div class="pmeta faint">{p.authors} · <span class="venue">{p.venue}</span></div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .src-note { margin-bottom: 2rem; font-size: var(--step--1); }
  .yr { margin-bottom: 2rem; }
  .year { font-size: var(--step-1); color: var(--muted); font-weight: 700; padding-bottom: .5rem; border-bottom: 1px solid var(--border); }
  .pubs { list-style: none; padding: 0; margin-top: 1rem; display: grid; gap: 1.1rem; max-width: var(--measure); }
  .ptitle { font-weight: 600; }
  a.ptitle:hover { color: var(--blue); }
  .pmeta { font-size: var(--step--1); margin-top: .25rem; }
  .venue { color: var(--muted); }
</style>
