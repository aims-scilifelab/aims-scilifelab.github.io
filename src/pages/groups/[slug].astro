---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Avatar from '../../components/Avatar.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const groups = await getCollection('groups', (g) => !g.data.draft);
  return groups.map((g) => ({ params: { slug: g.slug }, props: { group: g } }));
}
const { group } = Astro.props;
const { Content } = await group.render();

const people = await getCollection('people', (p) => !p.data.draft);
const lead = people.find((p) => p.data.name === group.data.lead)?.data;

// Selected publications: the lab lead's papers, pulled from the global list by
// surname (no per-lab data entry). Hidden when there are no matches.
const pubs = (await getEntry('publications', 'all'))?.data.items ?? [];
const surname = (group.data.lead || '').trim().split(/\s+/).pop() || '';
const keyPubs = surname
  ? pubs
      .filter((p) => (p.authors || '').toLowerCase().includes(surname.toLowerCase()))
      .sort((a, b) => b.year - a.year)
      .slice(0, 6)
  : [];

const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---
<Base title={group.data.name} description={group.data.tagline || `The ${group.data.name} at AIMS.`}>
  <PageHeader eyebrow="Lab" title={group.data.name} lede={group.data.tagline}>
    <p class="gback"><a class="link" href="/groups">← All labs</a></p>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap">
      <div class="prose measure"><Content /></div>
      {group.data.focus.length > 0 && (
        <ul class="kw">{group.data.focus.map((k) => <li class="tag">{k}</li>)}</ul>
      )}

      {lead && (
        <article class="card lead-card">
          <div class="avatar" aria-hidden="true">
            <Avatar photo={lead.photo} name={lead.name} />
          </div>
          <div>
            <p class="faint role-l">Lab lead</p>
            <h2 class="ln">{lead.name}</h2>
            <p class="muted">{lead.role}{lead.affiliation ? ` · ${lead.affiliation}` : ''}</p>
            <div class="links">
              {lead.website && <a class="link" href={lead.website} target="_blank" rel="noopener">Website</a>}
              {lead.google_scholar && <a class="link" href={lead.google_scholar} target="_blank" rel="noopener">Scholar</a>}
              <a class="link" href="/people">Profile →</a>
            </div>
          </div>
        </article>
      )}

      {keyPubs.length > 0 && (
        <div class="pubs-block">
          <h2 class="cat">Selected publications</h2>
          <ul class="pubs">
            {keyPubs.map((p) => (
              <li>
                {p.url
                  ? <a class="ptitle" href={p.url} target="_blank" rel="noopener">{p.title}</a>
                  : <span class="ptitle">{p.title}</span>}
                <div class="pmeta faint">{p.authors}{p.venue ? ` · ${p.venue}` : ''}{p.year ? ` · ${p.year}` : ''}</div>
              </li>
            ))}
          </ul>
          <p class="more2"><a class="link" href="/publications">All publications →</a></p>
        </div>
      )}

      {keyPubs.length === 0 && (
        <p class="more2"><a class="link" href="/publications">Publications →</a> &nbsp;·&nbsp; <a class="link" href="/people">People →</a></p>
      )}
    </div>
  </section>
</Base>

<style>
  .gback { margin-top: 1rem; font-size: var(--step--1); }
  .kw { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1.4rem; }
  .lead-card { display: flex; gap: 1.1rem; align-items: center; padding: 1.3rem; margin-top: 1.8rem; max-width: var(--measure); }
  .role-l { text-transform: uppercase; letter-spacing: .07em; font-size: var(--step--1); }
  .lead-card .ln { font-size: var(--step-1); margin-top: .1rem; }
  .lead-card .links { display: flex; gap: 14px; margin-top: .6rem; font-size: var(--step--1); flex-wrap: wrap; }
  .avatar { flex: 0 0 auto; width: 72px; height: 72px; border-radius: 50%; overflow: hidden; background: var(--bg-3);
            display: grid; place-items: center; color: var(--muted); font-weight: 700; border: 1px solid var(--border); }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }

  .pubs-block { margin-top: 2.6rem; }
  .cat { font-size: var(--step-1); }
  .pubs { list-style: none; padding: 0; margin-top: 1.2rem; display: grid; gap: 1.1rem; max-width: var(--measure); }
  .ptitle { font-weight: 600; }
  a.ptitle:hover { color: var(--blue); }
  .pmeta { font-size: var(--step--1); margin-top: .25rem; }
  .more2 { margin-top: 1.8rem; }
</style>
