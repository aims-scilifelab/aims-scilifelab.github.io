---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EventStories from '../components/EventStories.astro';
import OutingGrid from '../components/OutingGrid.astro';
import ResearchArchive from '../components/ResearchArchive.astro';
import Lightbox from '../components/Lightbox.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('gallery', (g) => !g.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);

// An event's `type` decides its section. Everything not listed here
// (social, retreat, other) goes under Team outings.
const researchTypes = ['conference', 'talk', 'defense', 'graduation', 'visit', 'milestone'];
const research = entries.filter((e) => researchTypes.includes(e.data.type));
const outings  = entries.filter((e) => !researchTypes.includes(e.data.type));

// Research life: the newest RECENT events (plus any with `featured: true`)
// are shown as large stories; everything else goes into the yearly archive.
const RECENT = 3;
const isStory = (e: (typeof research)[number], i: number) => i < RECENT || e.data.featured;
const stories = research.filter(isStory);
const archive = research.filter((e, i) => !isStory(e, i));
---
<Base title="Life at AiMS" description="Research is more than papers and models — a look at the people and community behind AiMS.">
  <PageHeader eyebrow="Life at AiMS" title="Life at AiMS"
    lede="Research is more than papers and models." />

  <section class="section-tight">
    <div class="wrap">
      <h2 class="cat">How we work</h2>
      <ul class="how measure muted">
        <li>A weekly reading group where we discuss papers worth understanding.</li>
        <li>Regular research discussions across machine learning, medicine and biology.</li>
        <li>Shared supervision and collaboration across groups.</li>
        <li>Close interaction between ML methods and their scientific and clinical applications.</li>
      </ul>
    </div>
  </section>

  {research.length > 0 && (
    <section class="section-tight" aria-labelledby="research-life">
      <div class="wrap">
        <h2 id="research-life" class="cat">Research life</h2>
        <p class="lede muted measure">Conferences, talks, defenses and the milestones along the way.</p>
        <EventStories entries={stories} eager={2} />
        {archive.length > 0 && <ResearchArchive entries={archive} />}
      </div>
    </section>
  )}

  {outings.length > 0 && (
    <section class="section-tight" aria-labelledby="team-outings">
      <div class="wrap">
        <h2 id="team-outings" class="cat">Team outings</h2>
        <p class="lede muted measure">The lab away from the lab.</p>
        <OutingGrid entries={outings} eager={research.length > 0 ? 0 : 4} />
      </div>
    </section>
  )}

  {entries.length === 0 && (
    <section class="section-tight">
      <div class="wrap">
        <p class="muted measure evergreen">Photos from conferences, defenses, retreats, fika and ordinary lab moments
        will appear here as we add them.</p>
      </div>
    </section>
  )}
  <Lightbox />
</Base>

<style>
  .cat { font-size: var(--step-2); }
  .lede { margin: .5rem 0 0; }
  .how { margin-top: 1.2rem; padding-left: 1.2rem; display: grid; gap: .5rem; }
  .evergreen { margin-top: 1.2rem; }
</style>
