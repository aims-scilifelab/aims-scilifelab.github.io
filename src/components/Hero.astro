---
import { getEntry } from 'astro:content';
import katex from 'katex';
import 'katex/dist/katex.min.css';
const s = (await getEntry('site', 'settings'))!.data;
const h = (await getEntry('home', 'home'))!.data;

// Hero math panel — a variational-inference (ELBO) derivation, typeset with
// KaTeX at build time. Each LINE is rendered on its own so it can be revealed
// one at a time (see 'math:elbo' in the AI list). \hphantom{...} reserves the
// width of the head so every continuation "=" lines up as one aligned block.
const TEX = (s: string) => katex.renderToString(s, { displayMode: true, throwOnError: false });
const HP = String.raw`\hphantom{\log p(x)}`;   // aligns continuation lines in the ELBO panel

// (1) Evidence lower bound / variational inference
const elboLines = [
  { tex: String.raw`\log p(x) = \log \int p(x,z)\,\mathrm{d}z` },
  { tex: HP + String.raw`{}= \log \int q(z\mid x)\,\frac{p(x,z)}{q(z\mid x)}\,\mathrm{d}z` },
  { tex: HP + String.raw`{}= \log \mathbb{E}_{q}\!\left[\frac{p(x,z)}{q(z\mid x)}\right]` },
  { tex: HP + String.raw`{}\ge \mathbb{E}_{q}\!\left[\log \frac{p(x,z)}{q(z\mid x)}\right]` },
  { tex: HP + String.raw`{}= \mathbb{E}_{q}\!\left[\log p(x\mid z)\right]` },
  { tex: HP + String.raw`\quad {}-\ \mathrm{KL}\!\left(q(z\mid x)\,\|\,p(z)\right)` },
  { tex: HP + String.raw`{}=: \mathcal{L}(x)` },
  { tex: String.raw`\log p(x) = \mathcal{L}(x) + \mathrm{KL}\!\left(q(z\mid x)\,\|\,p(z\mid x)\right)`, gap: true },
  { tex: String.raw`z = \mu_\phi(x) + \sigma_\phi(x)\odot\epsilon,\quad \epsilon\sim\mathcal{N}(0,I)`, gap: true },
  { tex: String.raw`\nabla_\phi \mathcal{L} = \mathbb{E}_{\epsilon}\!\left[\nabla_\phi \log \frac{p(x,z)}{q(z\mid x)}\right]` },
  { tex: String.raw`\theta^\star,\phi^\star = \arg\max_{\theta,\phi}\ \sum_i \mathcal{L}(x_i)`, gap: true },
];

const mathSets = { elbo: elboLines.map((l) => ({ html: TEX(l.tex), gap: !!l.gap })) };

// Rotating background — alternates AI ↔ bio, mixing video clips and stills.
// Add/remove files in public/hero/ and edit these two lists.
const AI = [
  'ai_chip.mp4', 'ai_datacenter.mp4', 'ai_fiber.mp4', 'ai_llm.mp4', 'ai_umap.mp4',
  'ai_drug_discovery.mp4', 'ai_loss_landscape.mp4', 'ai_vit.mp4', 'ai_neural.mp4',
  'math:elbo',     // a typeset math derivation (see the math-slide helpers in the script below)
  'code:medvqa',   // a live-typed code panel (see the code-slide helpers in the script below)
];
const BIO = [
  'bio_cell.mp4', 'bio_blood.mp4', 'bio_dna_translation.mp4', 'bio_rna_transcription.mp4',
  'med_ultrasound_ai.mp4', 'bio_dividing_cells.mp4', 'bio_spatial.mp4',
  'micro_fluorescence_cells.png', 'med_fundus.mp4', 'micro_em.png',
  'med_kidney.mp4', 'bio_cell_illustration.png', 'med_mammogram.mp4',
  'chestxray.png', 'brainmri.png', 'cellpainting.png', 'neurons.png',
  'seq:dna',   // a scrolling DNA/RNA sequence panel (see the seq-slide helpers in the script below)
];
---
<header class="hero">
  <div class="bg" aria-hidden="true">
    <!-- No poster image: the hero starts on solid black and the first clip fades in over it. -->
    <div class="layer" id="hL0"></div>
    <div class="layer" id="hL1"></div>
    <div class="veil"></div><div class="vig"></div><div class="vig-edge"></div>
  </div>

  <div class="wrap"><div class="hero-in">
    <h1 class="wordmark">{s.name}</h1>
    <p class="descriptor">AI <span class="x">×</span> Medicine <span class="x">×</span> Life Sciences</p>
    <p class="core">{h.coreStatement}</p>
    <p class="support muted">{h.supporting}</p>
    <p class="inst faint">
      <a href="https://www.kth.se" target="_blank" rel="noopener">{s.institution[0]}</a> ·
      <a href="https://www.scilifelab.se" target="_blank" rel="noopener">SciLifeLab</a> ·
      {s.location.split(',')[0]}
    </p>
    <div class="cta">
      <a class="btn btn-primary" href={h.ctaPrimary.href}>{h.ctaPrimary.label}</a>
      <a class="btn btn-ghost" href={h.ctaSecondary.href}>{h.ctaSecondary.label}</a>
    </div>
  </div></div>
</header>

<style>
  .hero { position: relative; isolation: isolate; min-height: 88svh; display: flex; align-items: center;
          padding-block: clamp(3rem, 8vh, 7rem); overflow: hidden; }
  .bg { position: absolute; inset: 0; z-index: -1; background: #000; }
  .layer :global(video), .layer :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .layer { position: absolute; inset: 0; opacity: 0; transition: opacity 1.1s ease; }
  .layer :global(video), .layer :global(img) { filter: saturate(.9) brightness(.98) contrast(1.05); will-change: transform; }
  .layer :global(.kb) { animation: kb 12s ease-out forwards; }
  @keyframes kb { from { transform: scale(1.07) rotate(-0.8deg); } to { transform: scale(1.2) translate(-1.4%,-1%) rotate(1deg); } }
  /* Veil keeps the headline legible on the left; right side is left much brighter now. */
  .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,8,12,.86), rgba(8,8,12,.42) 52%, rgba(8,8,12,.08)); }
  .vig  { position: absolute; inset: 0; background: radial-gradient(135% 135% at 42% 45%, transparent 55%, rgba(0,0,0,.44)); }
  /* A small dim band along the top and bottom edges only. */
  .vig-edge { position: absolute; inset: 0; pointer-events: none;
              background: linear-gradient(180deg, rgba(0,0,0,.68) 0%, transparent 11%, transparent 89%, rgba(0,0,0,.72) 100%); }
  @media (max-width: 820px) {
    .vig-edge { background: linear-gradient(180deg, rgba(0,0,0,.76) 0%, transparent 12%, transparent 88%, rgba(0,0,0,.80) 100%); }
  }

  /* left-aligned column on the content grid; imagery breathes on the right */
  .hero-in { max-width: 34rem; margin-inline: 0; }
  @media (min-width: 900px) { .hero-in { max-width: 44rem; } }
  .wordmark { font-size: clamp(4rem, 13vw, 10rem); font-weight: 800; letter-spacing: -.04em; line-height: .95;
              text-shadow: 0 2px 40px rgba(0,0,0,.6); }
  .descriptor { font-size: clamp(1.15rem, 3.6vw, 2.1rem); font-weight: 600; letter-spacing: -.01em;
                margin-top: .35rem; color: #e7e9f0; text-shadow: 0 2px 22px rgba(0,0,0,.6); }
  .descriptor .x { font-weight: 500; }
  .core { font-size: var(--step-1); font-weight: 600; margin-top: 1.4rem; max-width: 40ch; text-shadow: 0 2px 18px rgba(0,0,0,.55); }
  .support { font-size: var(--step-0); margin-top: .8rem; max-width: 54ch; text-shadow: 0 1px 14px rgba(0,0,0,.5); }
  .inst { margin-top: 1.1rem; font-size: var(--step--1); letter-spacing: .01em; }
  .inst a { color: inherit; text-decoration: underline; text-decoration-color: rgba(255,255,255,.28); text-underline-offset: 2px; }
  .inst a:hover { color: var(--text); text-decoration-color: var(--muted); }
  .cta { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 1.8rem; }

  @media (max-width: 520px) {
    .hero { min-height: 82svh; }
    .cta { flex-direction: column; align-items: stretch; }
    .cta .btn { justify-content: center; }
  }
</style>

<script define:vars={{ AI, BIO, mathSets }}>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarseSmall = matchMedia('(max-width: 820px)').matches;

  // ---- Code slide -------------------------------------------------------
  // A tiny "editor" panel that types out a snippet, no video/mp4 involved.
  // Any list entry that starts with "code:" renders this instead of a file.
  // Edit CODE to change what's typed. Colours live in global.css (.codeslide).
  const CODE = [
    "import torch",
    "from diffusers import (",
    "    AutoencoderKL,",
    "    DDIMScheduler,",
    "    UNet2DConditionModel,",
    ")",
    "from transformers import CLIPTextModel",
    "",
    "# chest x-ray latent diffusion models",
    "MODELS = {",
    "    'roentgen': 'stanfordmimi/RoentGen-v2',",
    "    'covid64': 'teohyc/Covid-XRay-Diffusion',",
    "}",
    "",
    "def load(model='roentgen'):",
    "    repo = MODELS[model]",
    "    dt = {'torch_dtype': torch.float32}",
    "    unet = UNet2DConditionModel.from_pretrained(",
    "        repo, subfolder='unet', **dt)",
    "    vae = AutoencoderKL.from_pretrained(",
    "        repo, subfolder='vae', **dt)",
    "    sched = DDIMScheduler.from_pretrained(",
    "        repo, subfolder='scheduler')",
    "    return unet, vae, sched",
  ].join("\n");
  const csEsc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
  // Single pass so we never re-scan (and corrupt) markup we've already inserted.
  // Order matters: comment first (consumes the rest of a line, incl. any quotes),
  // then strings (with optional f/r/b prefix), then keywords, then numbers.
  const CS_RE = /(#[^\n]*)|([frbFRB]{0,2}(?:'[^'\n]*'|"[^"\n]*"))|\b(import|from|as|with|def|return|for|in|if|elif|else|not|and|or|is|None|True|False|print|class|try|except|finally|while|lambda|yield|global|assert|pass|break|continue|async|await|del|raise)\b|\b(\d+\.?\d*)\b/g;
  const hlCode = (s) => csEsc(s).replace(CS_RE, (m, c, str, kw) =>
    c ? '<span class="c">' + c + '</span>'
    : str ? '<span class="s">' + str + '</span>'
    : kw ? '<span class="k">' + kw + '</span>'
    : '<span class="n">' + m + '</span>');
  const buildCode = () => {
    const wrap = document.createElement('div');
    wrap.className = 'codeslide nokb';
    wrap.innerHTML = '<div class="cs-window"><div class="cs-bar"><i></i><i></i><i></i><b>xray_diffusion.py</b></div>'
      + '<pre class="cs-pre"><code class="cs-code"></code><span class="cs-caret"></span></pre></div>';
    const codeEl = wrap.querySelector('.cs-code');
    const per = Math.max(13, Math.floor(4200 / CODE.length));
    let i = 0;
    const type = () => {
      if (!wrap.isConnected) return;
      i += 1; codeEl.innerHTML = hlCode(CODE.slice(0, i));
      if (i < CODE.length) setTimeout(type, per);
    };
    setTimeout(type, 260);   // small beat before typing starts
    return wrap;
  };
  const isCode = (f) => typeof f === 'string' && f.indexOf('code:') === 0;

  // ---- Sequence slide ---------------------------------------------------
  // Rows of colour-coded DNA/RNA bases scrolling sideways, each row at its
  // own speed and direction. No video/mp4. Colours live in global.css.
  const isSeq = (f) => typeof f === 'string' && f.indexOf('seq:') === 0;
  // A real fragment of the human TP53 (p53) tumour-suppressor coding sequence.
  const TP53 = '';
  const SEQ_LEN = 130;   // bases-per-half (content is doubled so the row loops)
  const colorSeq = (seq) => seq.replace(/[ATGCU]/g, (c) => '<span class="b' + c + '">' + c + '</span>');
  const buildSeq = () => {
    const wrap = document.createElement('div');
    wrap.className = 'seqslide nokb';
    // A dense wall that fills the whole hero on every screen; on phones the
    // rows are bigger and scroll a bit faster (see global.css for the sizing).
    const small = matchMedia('(max-width: 820px)').matches;
    const SEQ_ROWS = small ? 30 : 32;
    const G = TP53 + TP53;                                  // doubled so any window of SEQ_LEN exists
    const start = Math.floor(Math.random() * TP53.length);  // a different window each appearance
    let html = '<div class="seq-rows">';
    for (let r = 0; r < SEQ_ROWS; r++) {
      const off = (start + r * SEQ_LEN) % TP53.length;      // lay the gene out row by row
      let slice = G.slice(off, off + SEQ_LEN);
      if (r % 5 === 4) slice = slice.replace(/T/g, 'U');    // every 5th row = mRNA (T→U)
      const colored = colorSeq(slice);
      const dur = small ? (14 + (r % 8) * 4) : (30 + (r % 8) * 6);   // every line a different speed
      html += '<div class="seq-row seq-r" style="animation-duration:' + dur + 's">'
            + '<span class="seq-run">' + colored + colored + '</span></div>';  // all flow the same way, rightward
    }
    html += '</div>';
    wrap.innerHTML = html;
    return wrap;
  };

  // ---- Math slide -------------------------------------------------------
  // A variational-inference derivation, typeset with KaTeX at build time and
  // handed in as `mathBlocks`. buildMath just reveals each block in turn.
  const isMath = (f) => typeof f === 'string' && f.indexOf('math:') === 0;
  const buildMath = (key) => {
    const blocks = mathSets[key] || mathSets.elbo;
    const wrap = document.createElement('div');
    wrap.className = 'mathslide nokb';
    let lines = '';
    blocks.forEach((b, i) => {
      const delay = (0.2 + i * 0.65).toFixed(2);   // each line wipes in after the last
      lines += '<div class="ms-line' + (b.gap ? ' ms-gap' : '') + '" style="animation-delay:' + delay + 's">' + b.html + '</div>';
    });
    wrap.innerHTML = '<div class="ms-window"><div class="ms-body">' + lines + '</div></div>';
    return wrap;
  };

  // Static poster only on reduced-motion or small screens (perf + one-video-at-a-time on mobile).
  if (!reduce && !coarseSmall && (AI.length || BIO.length)) {
    const layers = [document.getElementById('hL0'), document.getElementById('hL1')];
    let poster = document.querySelector('.poster');  // hidden once the first clip is up (else it shows through crossfades)
    const MAX_DWELL = 6000, IMG_DWELL = 6000, FADE = 1100;
    const isVid = (f) => /\.(mp4|webm|mov)$/i.test(f);
    let cur = 0, lastGroup = 'AI', qAI = [], qBIO = [], timer = null;
    const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const nextFrom = (g) => { let q = g === 'AI' ? qAI : qBIO; if (!q.length) { q = shuffle((g === 'AI' ? AI : BIO).slice()); if (g === 'AI') qAI = q; else qBIO = q; } return q.pop(); };
    const pick = () => { lastGroup = lastGroup === 'AI' ? 'BIO' : 'AI'; const g = (lastGroup === 'AI' && !AI.length) ? 'BIO' : (lastGroup === 'BIO' && !BIO.length) ? 'AI' : lastGroup; lastGroup = g; return { file: nextFrom(g), group: g }; };
    const build = (info) => new Promise((res) => {
      let el, done = false; const ok = () => { if (!done) { done = true; res(el); } }; const fail = () => { if (!done) { done = true; res(null); } };
      if (isCode(info.file)) { el = buildCode(); ok(); return; }
      if (isSeq(info.file))  { el = buildSeq();  ok(); return; }
      if (isMath(info.file)) { el = buildMath(info.file.slice(5)); ok(); return; }
      if (isVid(info.file)) {
        el = document.createElement('video');
        el.muted = true; el.defaultMuted = true; el.autoplay = true; el.playsInline = true; el.loop = false;
        el.setAttribute('muted', ''); el.setAttribute('playsinline', ''); el.preload = 'auto'; el.src = 'hero/' + info.file;
        el.addEventListener('loadeddata', ok, { once: true }); el.addEventListener('canplay', ok, { once: true });
        el.addEventListener('error', fail, { once: true }); setTimeout(ok, 5000); el.load();
      } else {
        el = document.createElement('img'); el.decoding = 'async'; el.src = 'hero/' + info.file;
        el.addEventListener('load', ok, { once: true }); el.addEventListener('error', fail, { once: true }); setTimeout(ok, 5000);
      }
    });
    const dwell = (el) => el.classList.contains('codeslide') ? 11000
      : el.classList.contains('mathslide') ? 13000
      : el.classList.contains('seqslide') ? 9500
      : (el.tagName === 'VIDEO' && isFinite(el.duration) && el.duration > 0) ? Math.min(el.duration * 1000, MAX_DWELL) : IMG_DWELL;
    async function next() {
      const info = pick(); const el = await build(info);
      if (!el) { timer = setTimeout(next, 200); return; }
      const show = layers[1 - cur]; show.innerHTML = ''; show.appendChild(el);
      if (!el.classList.contains('nokb')) { el.classList.remove('kb'); void el.offsetWidth; el.classList.add('kb'); }
      const hero = document.querySelector('.hero');
      if (hero) hero.classList.toggle('panelmode', el.classList.contains('codeslide') || el.classList.contains('seqslide') || el.classList.contains('mathslide'));
      if (el.tagName === 'VIDEO') el.play().catch(() => {});
      show.style.opacity = 1; layers[cur].style.opacity = 0;
      if (poster) { poster.style.opacity = '0'; poster = null; }  // first clip is up — retire the poster so it can't show through crossfades
      const old = cur; cur = 1 - cur;
      const oldV = layers[old].querySelector('video'); if (oldV) { try { oldV.pause(); } catch (e) {} }
      clearTimeout(timer); timer = setTimeout(next, Math.max(1500, dwell(el) - FADE));
      setTimeout(() => { layers[old].innerHTML = ''; }, FADE + 100);
    }
    next();
  } else if (!reduce && coarseSmall && (AI.length || BIO.length)) {
    // MOBILE: cycles STILL, video, STILL, video … through ALL videos (stills interleaved,
    // and cycled if there are fewer of them). Only one video decodes at a time, with a still
    // between each — so it stays light on phones. Stills get a soft Ken Burns. All muted.
    const layers = [document.getElementById('hL0'), document.getElementById('hL1')];
    let poster = document.querySelector('.poster');
    const isVid = (f) => /\.(mp4|webm|mov)$/i.test(f);
    const all = [...AI, ...BIO];
    const vids = all.filter(isVid);
    // On phones the code editor and math derivation are too fine to read behind
    // the hero text, so they're desktop-only. Mobile stills = images + the gene.
    const stills = all.filter((f) => !isVid(f) && !isCode(f) && !isMath(f));
    const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const vOrder = shuffle(vids.slice());    // all videos, random order
    const sOrder = shuffle(stills.slice());  // all stills, random order
    let queue;
    if (vOrder.length && sOrder.length) {
      queue = [];
      vOrder.forEach((v, i) => { queue.push(sOrder[i % sOrder.length], v); });  // still, video, still, video …
    } else {
      queue = shuffle([...vOrder, ...sOrder]);   // fallback if there are no stills (or no videos)
    }
    if (queue.length) {
      const DWELL = 5000, FADE = 1100;
      let cur = 0, idx = -1;
      const mk = (file) => {
        if (isCode(file)) return buildCode();
        if (isSeq(file)) return buildSeq();
        if (isMath(file)) return buildMath(file.slice(5));
        if (isVid(file)) {
          const v = document.createElement('video');
          v.muted = true; v.defaultMuted = true; v.autoplay = true; v.loop = true; v.playsInline = true;
          v.setAttribute('muted', ''); v.setAttribute('playsinline', ''); v.preload = 'auto'; v.src = 'hero/' + file;
          v.play().catch(() => {});
          return v;
        }
        const im = document.createElement('img'); im.decoding = 'async'; im.src = 'hero/' + file; im.classList.add('kb');
        return im;
      };
      const step = () => {
        idx = (idx + 1) % queue.length;
        const file = queue[idx];
        const show = layers[1 - cur];
        show.innerHTML = ''; show.appendChild(mk(file));
        const hero = document.querySelector('.hero');
        if (hero) hero.classList.toggle('panelmode', isCode(file) || isSeq(file) || isMath(file));
        show.style.opacity = 1; layers[cur].style.opacity = 0;
        if (poster) { poster.style.opacity = '0'; poster = null; }
        const old = cur; cur = 1 - cur;
        setTimeout(() => { const v = layers[old].querySelector('video'); if (v) { try { v.pause(); } catch (e) {} } layers[old].innerHTML = ''; }, FADE + 100);
        setTimeout(step, isCode(file) ? 11000 : (isSeq(file) || isMath(file)) ? 9500 : DWELL);
      };
      step();
    }
  }
</script>
