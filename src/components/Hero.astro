---
import { getEntry } from 'astro:content';
const s = (await getEntry('site', 'settings'))!.data;
const h = (await getEntry('home', 'home'))!.data;
// Rotating background — alternates AI ↔ bio, mixing video clips and stills.
// Add/remove files in public/hero/ and edit these two lists.
const AI = [
  'ai_chip.mp4', 'ai_datacenter.mp4', 'ai_fiber.mp4', 'ai_llm.mp4', 'ai_umap.mp4',
  'ai_drug_discovery.mp4', 'ai_diffusion_xray.mp4', 'ai_loss_landscape.mp4', 'ai_vit.mp4', 'ai_neural.mp4',
];
const BIO = [
  'bio_cell.mp4', 'bio_blood.mp4', 'bio_dna_translation.mp4', 'bio_rna_transcription.mp4',
  'med_ultrasound_ai.mp4', 'bio_dividing_cells.mp4', 'bio_spatial.mp4',
  'micro_fluorescence_cells.png', 'med_fundus.mp4', 'micro_em.png',
  'med_kidney.mp4', 'bio_cell_illustration.png', 'med_mammogram.mp4',
];
---
<header class="hero">
  <div class="bg" aria-hidden="true">
    <img class="poster" src="hero/poster.jpg" alt="" fetchpriority="high" />
    <div class="layer" id="hL0"></div>
    <div class="layer" id="hL1"></div>
    <div class="veil"></div><div class="vig"></div>
  </div>

  <div class="wrap"><div class="hero-in">
    <h1 class="wordmark">{s.name}</h1>
    <p class="descriptor">AI <span class="x">×</span> Medicine <span class="x">×</span> Life Sciences</p>
    <p class="core">{h.coreStatement}</p>
    <p class="support muted">{h.supporting}</p>
    <p class="inst faint">
      <a href="https://www.kth.se" target="_blank" rel="noopener">{s.institution[0]}</a> ·
      <a href="https://www.scilifelab.se" target="_blank" rel="noopener">SciLifeLab</a> ·
      {s.location.split(',')[0]}
    </p>
    <div class="cta">
      <a class="btn btn-primary" href={h.ctaPrimary.href}>{h.ctaPrimary.label}</a>
      <a class="btn btn-ghost" href={h.ctaSecondary.href}>{h.ctaSecondary.label}</a>
    </div>
  </div></div>
</header>

<style>
  .hero { position: relative; isolation: isolate; min-height: 88svh; display: flex; align-items: center;
          padding-block: clamp(3rem, 8vh, 7rem); overflow: hidden; }
  .bg { position: absolute; inset: 0; z-index: -1; background: #05060a; }
  .poster, .layer :global(video), .layer :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .poster { opacity: .62; filter: saturate(.9) brightness(.95) contrast(1.04); }
  .layer { position: absolute; inset: 0; opacity: 0; transition: opacity 1.1s ease; }
  .layer :global(video), .layer :global(img) { filter: saturate(.9) brightness(.98) contrast(1.05); will-change: transform; }
  .layer :global(.kb) { animation: kb 12s ease-out forwards; }
  @keyframes kb { from { transform: scale(1.05); } to { transform: scale(1.16) translate(-1.4%,-1%); } }
  /* Veil keeps the headline legible on the left; right side is left much brighter now. */
  .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,8,12,.86), rgba(8,8,12,.42) 52%, rgba(8,8,12,.08)); }
  .vig  { position: absolute; inset: 0; background: radial-gradient(135% 135% at 42% 45%, transparent 55%, rgba(0,0,0,.44)); }

  /* left-aligned column on the content grid; imagery breathes on the right */
  .hero-in { max-width: 34rem; margin-inline: 0; }
  @media (min-width: 900px) { .hero-in { max-width: 44rem; } }
  .wordmark { font-size: clamp(4rem, 13vw, 10rem); font-weight: 800; letter-spacing: -.04em; line-height: .95;
              text-shadow: 0 2px 40px rgba(0,0,0,.6); }
  .descriptor { font-size: clamp(1.15rem, 3.6vw, 2.1rem); font-weight: 600; letter-spacing: -.01em;
                margin-top: .35rem; color: #e7e9f0; text-shadow: 0 2px 22px rgba(0,0,0,.6); }
  .descriptor .x { font-weight: 500; }
  .core { font-size: var(--step-1); font-weight: 600; margin-top: 1.4rem; max-width: 40ch; text-shadow: 0 2px 18px rgba(0,0,0,.55); }
  .support { font-size: var(--step-0); margin-top: .8rem; max-width: 54ch; text-shadow: 0 1px 14px rgba(0,0,0,.5); }
  .inst { margin-top: 1.1rem; font-size: var(--step--1); letter-spacing: .01em; }
  .inst a { color: inherit; text-decoration: underline; text-decoration-color: rgba(255,255,255,.28); text-underline-offset: 2px; }
  .inst a:hover { color: var(--text); text-decoration-color: var(--muted); }
  .cta { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 1.8rem; }

  @media (max-width: 520px) {
    .hero { min-height: 82svh; }
    .cta { flex-direction: column; align-items: stretch; }
    .cta .btn { justify-content: center; }
  }
</style>

<script define:vars={{ AI, BIO }}>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarseSmall = matchMedia('(max-width: 820px)').matches;
  // Static poster only on reduced-motion or small screens (perf + one-video-at-a-time on mobile).
  if (!reduce && !coarseSmall && (AI.length || BIO.length)) {
    const layers = [document.getElementById('hL0'), document.getElementById('hL1')];
    let poster = document.querySelector('.poster');  // hidden once the first clip is up (else it shows through crossfades)
    const MAX_DWELL = 6000, IMG_DWELL = 6000, FADE = 1100;
    const isVid = (f) => /\.(mp4|webm|mov)$/i.test(f);
    let cur = 0, lastGroup = 'AI', qAI = [], qBIO = [], timer = null;
    const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const nextFrom = (g) => { let q = g === 'AI' ? qAI : qBIO; if (!q.length) { q = shuffle((g === 'AI' ? AI : BIO).slice()); if (g === 'AI') qAI = q; else qBIO = q; } return q.pop(); };
    const pick = () => { lastGroup = lastGroup === 'AI' ? 'BIO' : 'AI'; const g = (lastGroup === 'AI' && !AI.length) ? 'BIO' : (lastGroup === 'BIO' && !BIO.length) ? 'AI' : lastGroup; lastGroup = g; return { file: nextFrom(g), group: g }; };
    const build = (info) => new Promise((res) => {
      let el, done = false; const ok = () => { if (!done) { done = true; res(el); } }; const fail = () => { if (!done) { done = true; res(null); } };
      if (isVid(info.file)) {
        el = document.createElement('video');
        el.muted = true; el.defaultMuted = true; el.autoplay = true; el.playsInline = true; el.loop = false;
        el.setAttribute('muted', ''); el.setAttribute('playsinline', ''); el.preload = 'auto'; el.src = 'hero/' + info.file;
        el.addEventListener('loadeddata', ok, { once: true }); el.addEventListener('canplay', ok, { once: true });
        el.addEventListener('error', fail, { once: true }); setTimeout(ok, 5000); el.load();
      } else {
        el = document.createElement('img'); el.decoding = 'async'; el.src = 'hero/' + info.file;
        el.addEventListener('load', ok, { once: true }); el.addEventListener('error', fail, { once: true }); setTimeout(ok, 5000);
      }
    });
    const dwell = (el) => (el.tagName === 'VIDEO' && isFinite(el.duration) && el.duration > 0) ? Math.min(el.duration * 1000, MAX_DWELL) : IMG_DWELL;
    async function next() {
      const info = pick(); const el = await build(info);
      if (!el) { timer = setTimeout(next, 200); return; }
      const show = layers[1 - cur]; show.innerHTML = ''; show.appendChild(el);
      el.classList.remove('kb'); void el.offsetWidth; el.classList.add('kb');
      if (el.tagName === 'VIDEO') el.play().catch(() => {});
      show.style.opacity = 1; layers[cur].style.opacity = 0;
      if (poster) { poster.style.opacity = '0'; poster = null; }  // first clip is up — retire the poster so it can't show through crossfades
      const old = cur; cur = 1 - cur;
      const oldV = layers[old].querySelector('video'); if (oldV) { try { oldV.pause(); } catch (e) {} }
      clearTimeout(timer); timer = setTimeout(next, Math.max(1500, dwell(el) - FADE));
      setTimeout(() => { layers[old].innerHTML = ''; }, FADE + 100);
    }
    next();
  }
</script>
