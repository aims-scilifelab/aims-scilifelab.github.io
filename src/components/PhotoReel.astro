---
/* Auto-advancing frame showing every gallery photo in random order, with
 * a caption saying what it was. Clicking a photo opens the shared <Lightbox />.
 *
 * Maintenance: nothing to do, it picks up every non-draft gallery entry.
 * Photos whose alt text contains "placeholder" are skipped.
 *
 * Only the current photo and its neighbours are loaded. It pauses on hover,
 * keyboard focus, off-screen, or while the viewer is open, and does not
 * auto-advance for visitors who prefer reduced motion. */
import type { CollectionEntry } from 'astro:content';
import { lbData } from '../lib/lightbox';

interface Props { entries: CollectionEntry<'gallery'>[]; interval?: number; }
const { entries, interval = 5000 } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });

const KIND: Record<string, string> = {
  defense: 'PhD defense', conference: 'Conference', talk: 'Talk', graduation: 'Graduation',
  visit: 'Visit', milestone: 'Milestone', retreat: 'Retreat', social: 'Team outing',
};

// Team outings (social, retreat, other) show no description, only research events do.
const hasDesc = (e: CollectionEntry<'gallery'>) =>
  ['conference', 'talk', 'defense', 'graduation', 'visit', 'milestone'].includes(e.data.type);

const slides = entries.flatMap((e) =>
  e.data.photos.map((p, k) => ({ e, p, k })).filter(({ p }) => !/placeholder/i.test(p.alt))
).map(({ e, p, k }) => ({
  src: p.src,
  alt: p.alt,
  title: e.data.title,
  caption: p.caption,
  kind: KIND[e.data.type] ?? '',
  desc: hasDesc(e) ? e.data.description : '',
  // the kind label already says "PhD defense", so don't repeat it in the place
  sub: [e.data.place.replace(/^PhD defense\s*·\s*/, ''), fmt(e.data.date)].filter(Boolean).join(' · '),
  lb: lbData(e, { start: k, description: hasDesc(e) }),
}));
const first = slides[0];
const pad = (n: number) => String(n).padStart(2, '0');
---
{first && (
  <section class="reel-sec" aria-label="Photos from life at AiMS">
    <div class="wrap">
      <div class="reel" data-reel data-interval={interval} role="group" aria-roledescription="carousel" aria-label="Life at AiMS photos">
        <div class="aura" aria-hidden="true">
          <img class="show" data-aura alt="" src={first.src} />
          <img data-aura alt="" />
        </div>

        <div class="stage" data-stage>
          {slides.map((s, i) => (
            <button type="button" class:list={['slide', { on: i === 0 }]} data-slide data-lb={s.lb}
              data-title={s.title} data-caption={s.caption} data-sub={s.sub} data-src={s.src}
              data-kind={s.kind} data-desc={s.desc}
              aria-label={`Open photo from ${s.title}: ${s.alt}`}>
              <img class="bg" alt="" aria-hidden="true" src={i === 0 ? s.src : undefined} />
              <img class="fg" alt="" src={i === 0 ? s.src : undefined} fetchpriority={i === 0 ? 'high' : undefined} />
            </button>
          ))}
          {slides.length > 1 && <span class="progress" data-progress aria-hidden="true"></span>}
        </div>

        <div class="panel">
          <div class="cap" data-cap aria-live="off">
            <p class="kind" data-c-kind>{first.kind}</p>
            <h2 class="ttl" data-c-title>{first.title}</h2>
            <p class="pcap" data-c-caption>{first.caption}</p>
            <p class="sub" data-c-sub>{first.sub}</p>
            <p class="desc" data-c-desc>{first.desc}</p>
          </div>
          {slides.length > 1 && (
            <div class="ctl">
              <span class="n"><b data-count>01</b><i>/</i>{pad(slides.length)}</span>
              <span class="btns">
                <button type="button" class="btn-i" data-prev aria-label="Previous photo">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
                </button>
                <button type="button" class="btn-i play" data-toggle aria-label="Pause slideshow">
                  <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
                  <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.6 8z" /></svg>
                </button>
                <button type="button" class="btn-i" data-next aria-label="Next photo">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
                </button>
              </span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<script>
  const root = document.querySelector<HTMLElement>('[data-reel]');
  const slides = root ? [...root.querySelectorAll<HTMLElement>('[data-slide]')] : [];
  if (root && slides.length > 1) {
    // Random order on every visit. The first photo stays put: it is already in
    // the page's HTML, so swapping it would make the frame flash on load.
    for (let n = slides.length - 1; n > 1; n--) {
      const r = 1 + Math.floor(Math.random() * n);
      [slides[n], slides[r]] = [slides[r], slides[n]];
    }
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const toggle = $('[data-toggle]'), cap = $('[data-cap]'), stage = $('[data-stage]');
    const delay = +root.dataset.interval! || 5000;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, playing = !reduced, hovering = false, visible = true, elapsed = 0;
    const aura = [...root.querySelectorAll<HTMLImageElement>('[data-aura]')];
    const progress = $('[data-progress]');

    const load = (k: number) => {
      const s = slides[(k + slides.length) % slides.length];
      s.querySelectorAll('img').forEach((im) => { if (!im.getAttribute('src')) im.src = s.dataset.src!; });
    };
    let token = 0;
    const show = async (k: number) => {
      const n = (k + slides.length) % slides.length;
      if (n === i) return;
      const my = ++token, s = slides[n];
      load(n);
      // Wait until the next photo is ready, then fade it in over the current one.
      await Promise.race([
        s.querySelector<HTMLImageElement>('.fg')!.decode().catch(() => {}),
        new Promise((r) => setTimeout(r, 4000)),   // never let a slow photo stall the reel
      ]);
      if (my !== token) return;
      slides.forEach((x) => x.classList.remove('was'));
      slides[i].classList.remove('on');
      slides[i].classList.add('was');
      s.classList.add('on');
      i = n;
      load(i + 1); load(i - 1);
      const set = (sel: string, v?: string) => { $(sel).textContent = v || ''; };
      set('[data-c-kind]', s.dataset.kind); set('[data-c-title]', s.dataset.title);
      set('[data-c-caption]', s.dataset.caption); set('[data-c-sub]', s.dataset.sub);
      set('[data-c-desc]', s.dataset.desc);
      $('[data-count]').textContent = String(i + 1).padStart(2, '0');
      elapsed = 0;
      // the halo behind the frame follows the photo
      const [cur, nxt] = aura[0].classList.contains('show') ? aura : [aura[1], aura[0]];
      nxt.src = s.dataset.src!; nxt.classList.add('show'); cur.classList.remove('show');
      if (!reduced) cap.animate(
        [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }],
        { duration: 550, easing: 'cubic-bezier(.2,.7,.2,1)' });
      setTimeout(() => { if (my === token) slides.forEach((x) => x.classList.remove('was')); }, 900);
    };
    const setPlaying = (p: boolean) => {
      playing = p;
      root.classList.toggle('paused', !p);
      toggle.setAttribute('aria-label', p ? 'Pause slideshow' : 'Play slideshow');
      cap.setAttribute('aria-live', p ? 'off' : 'polite');
      elapsed = 0;
    };
    const held = () => hovering || !visible || document.hidden
      || !!root.querySelector(':focus-visible') || !!document.querySelector('dialog[open]');

    let prev = performance.now();
    const frame = (t: number) => {
      const dt = Math.min(t - prev, 100); prev = t;
      const h = held();
      root.classList.toggle('held', h);
      if (playing && !h) {
        elapsed += dt;
        if (elapsed >= delay) { elapsed = 0; show(i + 1); }
      }
      progress.style.transform = `scaleX(${Math.min(elapsed / delay, 1)})`;
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    $('[data-next]').addEventListener('click', () => show(i + 1));
    $('[data-prev]').addEventListener('click', () => show(i - 1));
    toggle.addEventListener('click', () => setPlaying(!playing));
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovering = true; });
    root.addEventListener('pointerleave', () => { hovering = false; });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'ArrowLeft') show(i - 1);
    });
    new IntersectionObserver(([en]) => { visible = en.isIntersecting; }, { threshold: 0.3 }).observe(root);

    let x0: number | null = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
    });

    load(1); load(-1);
    setPlaying(playing);
  }
</script>

<style>
  /* overflow-x: clip keeps the halo from widening the page on phones */
  .reel-sec { padding-top: clamp(.5rem, 2vw, 1.25rem); overflow-x: clip; }

  .reel { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 860px) {
    .reel { grid-template-columns: minmax(0, 1fr) clamp(270px, 27vw, 340px); }
  }

  /* soft halo in the colours of the current photo */
  .aura { position: absolute; inset: -6% -3%; z-index: -1; pointer-events: none; }
  .aura img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: blur(70px) saturate(1.5); opacity: 0; transition: opacity 1.4s ease; }
  .aura img.show { opacity: .36; }

  .stage { position: relative; aspect-ratio: 4 / 3; width: 100%; max-height: min(72vh, 640px); background: #000; overflow: hidden;
    border-radius: 14px 14px 0 0; box-shadow: inset 0 0 0 1px rgba(255,255,255,.08); }
  @media (min-width: 860px) { .stage { border-radius: 14px 0 0 14px; } }

  .slide { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in;
    opacity: 0; visibility: hidden; z-index: 0; }
  .slide.was { opacity: 1; visibility: visible; z-index: 1; pointer-events: none; }
  .slide.on { opacity: 1; visibility: visible; z-index: 2; transition: opacity .9s ease; }
  .slide:focus-visible { outline: 2px solid var(--blue); outline-offset: -4px; }
  .slide img { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* blurred copy fills the frame so tall or wide photos have no black bars */
  .bg { object-fit: cover; filter: blur(30px) brightness(.45) saturate(1.2); transform: scale(1.15); }
  .fg { object-fit: contain; }
  .on .fg, .was .fg { animation: drift 9s ease-out both; }
  .held .fg { animation-play-state: paused; }
  @keyframes drift { from { transform: scale(1); } to { transform: scale(1.045); } }

  /* time until the next photo */
  .progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; z-index: 3; background: var(--blue);
    transform: scaleX(0); transform-origin: left; transition: opacity .3s; }
  .paused .progress { opacity: 0; }

  .panel { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem;
    padding: clamp(1.1rem, 2.2vw, 1.7rem); min-width: 0;
    background: linear-gradient(165deg, var(--bg-3), var(--bg-2) 70%);
    border: 1px solid var(--border); border-top: 0; border-radius: 0 0 14px 14px; }
  @media (min-width: 860px) { .panel { border-top: 1px solid var(--border); border-left: 0; border-radius: 0 14px 14px 0; } }

  .cap { min-width: 0; min-height: 7.2rem; }
  .cap p, .cap h2 { margin: 0; }
  .kind { display: flex; align-items: center; gap: .55em; font-size: .72rem; font-weight: 600; letter-spacing: .12em;
    text-transform: uppercase; color: var(--blue); min-height: 1.3em; }
  .kind:not(:empty)::before { content: ""; width: 1.5em; height: 1px; background: currentColor; }
  .ttl { font-size: var(--step-2); font-weight: 700; line-height: 1.12; letter-spacing: -.015em; margin-top: .55rem !important;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .pcap { color: var(--text); margin-top: .5rem !important; font-size: var(--step-0); }
  .pcap:empty { display: none; }
  .sub { color: var(--faint); font-size: var(--step--1); margin-top: .4rem !important; }
  .desc { display: none; }
  @media (min-width: 860px) {
    .cap { min-height: 0; }
    .desc:not(:empty) { color: var(--muted); font-size: var(--step--1); line-height: 1.55; margin-top: .9rem !important;
      display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 6; overflow: hidden; }
  }

  .ctl { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .n { color: var(--faint); font-size: var(--step--1); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .n b { color: var(--text); font-weight: 600; }
  .n i { font-style: normal; margin: 0 .35em; opacity: .6; }
  .btns { display: flex; gap: 2px; }
  .btn-i { width: 44px; height: 44px; display: inline-grid; place-items: center; padding: 0;
    color: var(--muted); background: transparent; border: 0; border-radius: 999px; cursor: pointer; transition: color .15s, background .15s; }
  .btn-i:hover { color: var(--text); background: rgba(255,255,255,.07); }
  .btn-i:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }
  .btn-i svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .i-play { display: none; fill: currentColor !important; }
  .paused .i-play { display: block; }
  .paused .i-pause { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .slide.on, .aura img { transition: none; }
    .on .fg, .was .fg { animation: none; }
  }
</style>
