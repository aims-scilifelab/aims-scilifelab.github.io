---
import { getEntry } from 'astro:content';
const settings = (await getEntry('site', 'settings'))!.data;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
// A parent is "active" if it, or any of its dropdown children, is the current page.
const parentActive = (item: { href: string; children?: { href: string }[] }) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---
<nav aria-label="Primary">
  <div class="wrap nav-in">
    <a class="brand" href="/" aria-label={`${settings.name} — home`}>
      <span class="brand-name">{settings.name}</span>
    </a>

    <button id="navToggle" class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line class="l1" x1="3" y1="6" x2="21" y2="6"/><line class="l2" x1="3" y1="12" x2="21" y2="12"/><line class="l3" x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <ul id="navMenu" class="nav-links">
      {settings.nav.map((item) => (
        item.children ? (
          <li class="has-children">
            <a href={item.href}
               class={'parent ' + (parentActive(item) ? 'active' : '')}
               aria-current={parentActive(item) ? 'page' : undefined}>
              {item.label}<span class="caret" aria-hidden="true">▾</span>
            </a>
            <ul class="submenu">
              {item.children.map((c) => (
                <li>
                  <a href={c.href} class={isActive(c.href) ? 'active' : ''}
                     aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a href={item.href}
               class={(item.cta ? 'cta ' : '') + (isActive(item.href) ? 'active' : '')}
               aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        )
      ))}
    </ul>
  </div>
</nav>

<style>
  nav { position: sticky; top: 0; z-index: 40; background: rgba(10,10,14,.78);
        backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); }
  .brand { font-weight: 800; font-size: 1.18rem; letter-spacing: -.03em; }
  .nav-links { list-style: none; display: flex; gap: clamp(14px, 2vw, 26px); align-items: center; padding: 0; }
  .nav-links a { color: var(--muted); font-size: var(--step--1); font-weight: 500; padding: 6px 2px; }
  .nav-links a:hover { color: var(--text); }
  .nav-links a.active { color: var(--text); }
  .nav-links a.cta { color: var(--text); border: 1px solid var(--border-strong); border-radius: 8px; padding: 8px 14px; }
  .nav-links a.cta:hover { border-color: var(--blue); }

  /* Research dropdown */
  .has-children { position: relative; }
  .has-children > a.parent { display: inline-flex; align-items: center; gap: 4px; }
  .caret { font-size: .7em; line-height: 1; transition: transform .18s; opacity: .7; }
  .has-children:hover .caret, .has-children:focus-within .caret { transform: rotate(180deg); }
  .has-children::after {   /* invisible hover bridge to the submenu */
    content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 12px;
  }
  .submenu {
    list-style: none; margin: 0; padding: 6px; display: flex; flex-direction: column; gap: 2px;
    position: absolute; top: calc(100% + 10px); left: -10px; min-width: 190px;
    background: rgba(12,12,17,.98); backdrop-filter: blur(12px);
    border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 22px 44px rgba(0,0,0,.5);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .18s ease, transform .18s ease, visibility 0s linear .18s;
  }
  .has-children:hover .submenu, .has-children:focus-within .submenu {
    opacity: 1; visibility: visible; transform: translateY(0);
    transition: opacity .18s ease, transform .18s ease;
  }
  .submenu a { display: block; padding: 9px 12px; border-radius: 7px; white-space: nowrap; font-size: var(--step--1); }
  .submenu a:hover { background: var(--bg-3); color: var(--text); }
  .submenu a.active { color: var(--text); background: var(--bg-3); }

  .hamburger { display: none; background: none; border: 1px solid var(--border-strong); color: var(--text);
               width: 44px; height: 44px; border-radius: 9px; cursor: pointer; align-items: center; justify-content: center; }
  .hamburger .l1,.hamburger .l2,.hamburger .l3 { transition: transform .2s, opacity .2s; transform-origin: center; }

  @media (max-width: 820px) {
    .hamburger { display: inline-flex; }
    .nav-links {
      position: absolute; top: var(--nav-h); left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: rgba(9,9,13,.98); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border); padding: 6px 0;
      max-height: 0; overflow: hidden; visibility: hidden;
      transition: max-height .25s ease, visibility 0s linear .25s;
    }
    .nav-links.open { max-height: 80vh; visibility: visible; transition: max-height .28s ease; }
    .nav-links li { width: 100%; }
    .nav-links a { display: block; padding: 14px clamp(20px,5vw,40px); font-size: 1rem; }
    .nav-links a.cta { margin: 8px clamp(20px,5vw,40px); text-align: center; }

    /* Dropdown becomes an inline, always-open indented group on mobile. */
    .has-children::after { display: none; }
    .has-children > a.parent .caret { display: none; }
    .submenu {
      position: static; opacity: 1; visibility: visible; transform: none;
      background: none; border: 0; box-shadow: none; backdrop-filter: none;
      padding: 0; min-width: 0; transition: none;
    }
    .submenu a { padding: 12px clamp(20px,5vw,40px); padding-left: calc(clamp(20px,5vw,40px) + 18px);
                 font-size: .95rem; color: var(--muted); border-radius: 0; }
    .submenu a:hover, .submenu a.active { background: none; }
    .hamburger[aria-expanded="true"] .l1 { transform: translateY(6px) rotate(45deg); }
    .hamburger[aria-expanded="true"] .l2 { opacity: 0; }
    .hamburger[aria-expanded="true"] .l3 { transform: translateY(-6px) rotate(-45deg); }
  }
</style>

<script>
  const btn = document.getElementById('navToggle');
  const menu = document.getElementById('navMenu');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
    });
  }
</script>
