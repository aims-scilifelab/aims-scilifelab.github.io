---
// Person avatar: shows the photo if there is one, otherwise a neutral
// silhouette placeholder. Sizing/border come from the parent `.avatar`.
interface Props { photo?: string; name?: string; }
const { photo } = Astro.props;
---
{photo
  ? <img src={photo} alt="" loading="lazy" />
  : (
    <svg class="silhouette" viewBox="0 0 24 24" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <circle cx="12" cy="9" r="4.1" />
      <path d="M4 20.8c0-4 3.4-6.4 8-6.4s8 2.4 8 6.4v.8H4z" />
    </svg>
  )}
<style>
  img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .silhouette { width: 100%; height: 100%; display: block; fill: var(--faint); }
</style>
